{
  "name": "aicte-dashboard",
  "version": "1.0.0",
  "description": "AICTE Integrated Institution Complaint Monitoring & Status Dashboard (SIH 2026)",
  "main": "server/index.js",
  "scripts": {
    "seed": "node server/db/seed.js",
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently -n \"API,VITE\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "start": "node server/index.js",
    "build": "npm install --prefix client && npm run build --prefix client"
  },
  "keywords": [
    "aicte",
    "grievance",
    "sih",
    "dashboard",
    "regulation-bureau",
    "pgrc"
  ],
  "author": "Smart India Hackathon Team",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  }
}
