# =======================================================
# AICTE Integrated Complaint Monitoring & Status Portal
# Environment Configuration Template (.env.example)
# =======================================================

# Port on which the application server listens
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# Strong secret key for JWT session encryption (MANDATORY IN PRODUCTION)
# Generate a strong 64-char key: openssl rand -base64 32
JWT_SECRET=aicte_super_secure_random_jwt_secret_token_change_in_production_2026

# PostgreSQL Connection String (Optional for local offline demo, Mandatory on Cloud/Render)
# If omitted or left empty, the server automatically defaults to local SQLite persistence (server/data/aicte_cms.db)
# Example Neon / Supabase connection string:
# DATABASE_URL=postgresql://neondb_owner:password@ep-sample-1234.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
